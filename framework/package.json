{
  "name": "alepha-monorepo",
  "private": true,
  "description": "Alepha framework monorepo workspace",
  "workspaces": {
    "packages": [
      "packages/**/*",
      "apps/**/*",
      "!apps/**/*/dist"
    ]
  },
  "type": "module",
  "scripts": {
    "w": "yarn workspace",
    "a": "yarn alepha",
    "v": "yarn alepha verify",
    "verify": "yarn alepha verify",
    "clean": "yarn alepha clean",
    "copy": "yarn workspaces foreach -Wpt run copy && yarn workspace docs copy && yarn lint",
    "lint": "yarn alepha lint",
    "typecheck": "tsc --noEmit && yarn workspaces foreach -Wpt --exclude alepha-monorepo -j 4 run typecheck",
    "test": "yarn vitest run",
    "check:deps": "yarn workspaces foreach -Wpt exec depcheck .",
    "check:conventions": "node scripts/check-conventions.ts",
    "check:docs": "yarn workspace docs check:docs",
    "check:migrations": "yarn workspaces foreach -Wpt run check:migrations",
    "build": "yarn alepha package:docs && yarn workspaces foreach -Wpt run build",
    "test:bun": "bun test ./packages/**/*.bun.spec.ts",
    "test:broker": "yarn vitest run --config packages/@alepha/mqtt/vitest.broker.config.ts",
    "e2e": "yarn workspaces foreach -Wpt run e2e",
    "e2e-cli": "yarn w e2e-cli test"
  },
  "devDependencies": {
    "@alepha/lore": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "alepha": "^0.36.1",
    "depcheck": "^1.4.7",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "rolldown": "~1.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "workerd": {
      "built": true
    }
  }
}
