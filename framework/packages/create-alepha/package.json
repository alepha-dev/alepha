{
  "name": "create-alepha",
  "version": "0.36.1",
  "description": "Create a new Alepha project with a single command.",
  "keywords": [
    "alepha",
    "create",
    "framework",
    "scaffold",
    "typescript"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git"
  },
  "bin": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "bin": "./dist/index.js",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "alepha": "0.36.1",
    "tsdown": "^0.23.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "llms": "https://alepha.dev/llms.txt",
  "llmsLocal": "./docs"
}
