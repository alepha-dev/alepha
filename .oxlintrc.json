{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Only `correctness` — code that is outright wrong or useless — and it is an
  // error, so `yarn lint` and the CI `checks` job fail on a new finding.
  //
  // The wider categories were measured, not guessed: `correctness` +
  // `suspicious` + `perf` across all eleven plugins reports 11158 findings on
  // this repo, 5765 of them `react/react-in-jsx-scope` alone — a rule that is
  // simply wrong under the automatic JSX runtime this repo compiles with.
  // A gate nobody can pass is a gate nobody keeps.
  "categories": {
    "correctness": "error"
  },
  // `jsx-a11y` is deliberately absent: Biome ran with `a11y.recommended: false`
  // and turning it on here would be a new project, not a migration.
  // `react-perf` and `jsdoc` are absent for the same reason — 1793 and 36
  // findings respectively, none of them correctness.
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "import",
    "promise",
    "vitest"
  ],
  "rules": {
    // Biome split this in two: `noUnusedImports` was an error with a safe fix,
    // `noUnusedVariables` and `noUnusedFunctionParameters` were off. oxlint has
    // no rule that separates the import half from the variable half, so the
    // choice is all or nothing — and all is the better end state.
    //
    // Parameters stay exempt (`args: "none"`): an interface-mandated signature
    // routinely ignores an argument, and renaming those to `_` across every
    // implementation of a provider contract is churn with no reader benefit.
    // `^_` is the escape hatch for the rare deliberate binding.
    "no-unused-vars": [
      "error",
      {
        "args": "none",
        "caughtErrors": "none",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    // Every one of the 40 sites this reported is deliberate, and none is the
    // bug the rule describes. Three distinct shapes: the latest-ref pattern
    // (`ref.current = props.onChange`), which exists so a subscription made
    // once can reach the newest closure and which an effect assigns too late
    // for; refs that cache a value across renders precisely so re-rendering is
    // NOT triggered; and plain false positives — a ref object passed down as a
    // `ref` prop, and a ref read inside a `useState` lazy initializer, neither
    // of which is a render-phase read at all. The rule encodes React Compiler
    // semantics, which this codebase does not opt into.
    "react/refs": "off",
    // Every site is `{Icon && <Icon />}` where `Icon` came out of a
    // module-level registry (`ICONS[name] ?? CircleDashed`). The rule cannot
    // follow the lookup, so it reads a capitalised local as a component built
    // during render. Nothing here creates a component.
    "react/static-components": "off",
    // Not a correctness rule at all: it reports where React Compiler would
    // have to skip a component because its inferred deps differ from the
    // hand-written ones ("React Compiler has skipped optimizing this
    // component"). This repo does not compile with React Compiler, so the
    // diagnostic describes an optimisation that was never going to happen.
    "react/preserve-manual-memoization": "off",
    // Was `useExhaustiveDependencies: off` under Biome. Alepha's hooks take
    // primitives from the DI container, which are stable for the lifetime of
    // the container and which the rule cannot know are stable.
    "react-hooks/exhaustive-deps": "off",
    // Every spec in this repo takes `expect` from the Vitest fixture
    // (`test("…", async ({ expect }) => …)`) rather than importing it, and the
    // rule counts assertions by identifier — so it reports 477 tests full of
    // assertions as having none.
    "vitest/expect-expect": "off",
    // Style, not correctness: `expect(fn).toThrow()` without a message is the
    // documented pattern in CLAUDE.md and reads fine.
    "vitest/require-to-throw-message": "off",
    // Would require a type argument on every `vi.fn()` in the repo. The mocks
    // that matter here are DI substitutions, not typed call recorders.
    "vitest/require-mock-type-parameters": "off",
    // Fires on the retry/timeout specs, which legitimately assert different
    // things per branch.
    "vitest/no-conditional-expect": "off",
    // Vitest's `expect` takes an optional message as its second argument
    // (`expect(value, "which key failed")`), which Jest's does not. The rule
    // defaults to Jest's arity and reports every use of it.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // Control characters in regexes are intentional here — ANSI stripping and
    // the log formatters. Biome's equivalent was suppressed at four sites.
    "no-control-regex": "off"
  }
}
