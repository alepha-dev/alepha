{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"skipLibCheck": true,
		"declaration": true,
		"declarationMap": true,
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"allowSyntheticDefaultImports": true,
		"allowImportingTsExtensions": true
	},
	"exclude": ["node_modules", "dist"]
}
