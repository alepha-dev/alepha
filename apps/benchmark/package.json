{
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "alepha": "0.13.1",
    "autocannon": "^8.0.0",
    "express": "^5.1.0",
    "fastify": "^5.6.2",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "start": "node src/run-benchmark.ts",
    "raw": "node src/3004-node.ts",
    "express": "node src/3001-express.js",
    "fastify": "node src/3002-fastify.ts",
    "alepha": "node src/3003-alepha.ts",
    "alepha-bun": "SERVER_PORT=3005 bun src/3003-alepha.ts",
    "concurrent": "npm-run-all -p alepha alepha-bun express fastify raw",
    "prof:run": "node --prof src/3003-alepha.ts",
    "prof:process": "node --prof-process isolate-*.log > profile.txt && rm isolate-*.log",
    "clinic:run": "clinic flame -- node src/3003-alepha.ts",
    "clinic:test": "autocannon -c 100 -d 20 -p 10 http://localhost:3003/ping"
  }
}
