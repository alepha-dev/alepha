{
  "type": "module",
  "name": "benchmark",
  "private": true,
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "alepha": "0.25.2",
    "autocannon": "^8.0.0",
    "express": "^5.2.1",
    "fastify": "^5.12.0",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node src/run-benchmark.ts",
    "x-raw-node": "node src/3004-node.ts",
    "x-raw-bun": "bun src/3006-bun.ts",
    "x-express": "node src/3001-express.js",
    "x-fastify": "node src/3002-fastify.ts",
    "x-alepha": "node src/3003-alepha.ts",
    "x-alepha-bun": "SERVER_PORT=3005 bun src/3003-alepha.ts",
    "concurrent": "npm-run-all -p x-alepha x-alepha-bun x-express x-fastify x-raw-node x-raw-bun",
    "prof:run": "node --prof src/3003-alepha.ts",
    "prof:process": "node --prof-process isolate-*.log > profile.txt && rm isolate-*.log",
    "clinic:run": "clinic flame -- node src/3003-alepha.ts",
    "clinic:test": "autocannon -c 100 -d 20 -p 10 http://localhost:3003/ping",
    "kill": "bash scripts/kill-servers.sh"
  }
}
