{
  "private": true,
  "type": "module",
  "name": "playground",
  "scripts": {
    "dev": "alepha dev",
    "build": "alepha build --stats",
    "start": "yarn build && LOG_LEVEL=info LOG_FORMAT=pretty node dist",
    "wrangler": "alepha build --target=cloudflare && cd dist && wrangler",
    "wrangler:dev": "alepha build --target=cloudflare && cd dist && wrangler dev",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@alepha/ui": "workspace:^",
    "alepha": "workspace:^",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.13",
    "wrangler": "^4.93.0"
  }
}
