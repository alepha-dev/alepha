{
  "private": true,
  "type": "module",
  "name": "playground",
  "scripts": {
    "dev": "alepha dev",
    "build": "alepha build --stats",
    "build:docker": "alepha build --target=docker",
    "start": "yarn build && LOG_LEVEL=info LOG_FORMAT=pretty node dist",
    "wrangler": "alepha build --target=cloudflare && cd dist && wrangler",
    "wrangler:dev": "alepha build --target=cloudflare && cd dist && wrangler dev",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@alepha/ui": "workspace:^",
    "alepha": "workspace:^",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "vite": "^8.1.0",
    "wrangler": "^4.105.0"
  }
}
