# Lore local environment.
#
# `alepha dev` copies this file to `.env` on its first run when `.env` is
# missing (a fresh clone or a new worktree), so it must boot as it is: every
# value below is a working local default, and no step is needed by hand.
# `.env` is gitignored and never overwritten once it exists; put your own
# values there, never real secrets here.

# Registering with this address makes the account a realm administrator. Read
# once, when the realm settings are first seeded: a database imported from
# production keeps its stored settings and roles, so sign in there with your
# production account instead.
ADMIN_EMAIL=admin@alepha.dev

# Dev mode sends no mail: every message lands as JSON under
# `node_modules/.alepha/emails/`.
EMAIL_FROM="Lore <noreply@lore.alepha.dev>"

# Blank uses the built-in development secret (a warning at boot, refused in
# production). Sessions signed by production do not carry over either way.
APP_SECRET=

# Cloudflare Turnstile test keys: the widget renders and always passes.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# OAuth sign-in. A provider stays disabled while either of its two values is
# blank, so password sign-in is all a local run needs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
