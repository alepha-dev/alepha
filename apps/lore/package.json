{
  "private": true,
  "name": "lore",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "alepha build --stats",
    "build&start": "alepha build && LOG_LEVEL=debug LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "check:i18n": "alepha i18n check",
    "check:migrations": "alepha db migrations check",
    "db:generate": "alepha db migrations create",
    "build:docker": "alepha build --docker && cd dist && docker build -t alepha/lore .",
    "deploy": "alepha platform up -e production",
    "studio": "alepha db studio",
    "fonts": "node scripts/fetch-fonts.ts",
    "start": "yarn build && LOG_LEVEL=trace LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@alepha/devtools": "workspace:*",
    "@alepha/sigil": "workspace:*",
    "@alepha/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@lexical/react": "^0.48.0",
    "@lexical/rich-text": "^0.48.0",
    "@lexical/text": "^0.48.0",
    "@mdxeditor/editor": "^4.2.0",
    "@mdxeditor/gurx": "^1.2.1",
    "alepha": "workspace:*",
    "lexical": "^0.48.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  }
}
