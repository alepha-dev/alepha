{
  "private": true,
  "name": "lore",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "alepha build --stats",
    "build&start": "alepha build && LOG_LEVEL=debug LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "check:i18n": "alepha i18n check",
    "check:migrations": "alepha db migrations check",
    "db:generate": "alepha db migrations create",
    "build:docker": "alepha build --docker && cd dist && docker build -t alepha/lore .",
    "deploy": "alepha platform up -e production",
    "studio": "alepha db studio",
    "fonts": "node scripts/fetch-fonts.ts",
    "start": "yarn build && LOG_LEVEL=trace LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@alepha/devtools": "workspace:*",
    "@alepha/sigil": "workspace:*",
    "@alepha/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "alepha": "workspace:*",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-is": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.10.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  }
}
