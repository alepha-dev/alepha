{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "build": "alepha build",
    "typecheck": "tsc --noEmit",
    "start": "node dist",
    "wrangler": "cd dist && wrangler",
    "wrangler:dev": "cd dist && wrangler dev",
    "compile": "cd dist && bun build --compile --minify --bytecode index.js"
  },
  "dependencies": {
    "alepha": "^0.28.0"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
