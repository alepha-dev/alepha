{
  "name": "shop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "build": "alepha build --stats",
    "deploy": "alepha platform up -e production",
    "typecheck": "tsc --noEmit",
    "check:migrations": "alepha db migrations check",
    "db:generate": "alepha db migrations create",
    "start": "yarn build && LOG_LEVEL=info LOG_FORMAT=pretty node dist",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@alepha/commerce": "workspace:*",
    "@alepha/devtools": "workspace:*",
    "@alepha/lore": "workspace:*",
    "@alepha/payments-stripe": "workspace:*",
    "@alepha/ui": "workspace:*",
    "@fontsource-variable/archivo": "^5.3.0",
    "alepha": "workspace:^",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  }
}
