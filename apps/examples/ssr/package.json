{
  "name": "ssr",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "build": "alepha build --stats=json",
    "typecheck": "tsc --noEmit",
    "check:migrations": "alepha db migrations check",
    "build:docker": "alepha build --stats=json",
    "deploy": "alepha platform up --env production",
    "studio": "alepha db studio --mode=production",
    "db:generate": "alepha db generate",
    "db:migrate": "alepha db migrate --mode=production",
    "e2e": "yarn e2e:mode:dev && yarn e2e:mode:prod",
    "e2e:mode:dev": "CI=1 playwright test --config=./playwright.dev.config.ts",
    "e2e:mode:prod": "playwright test",
    "e2e:ui": "playwright test --ui",
    "start": "yarn build:e2e && yarn migrate:e2e && wrangler dev --cwd dist --persist-to ../node_modules/.wrangler-e2e",
    "start:e2e": "CI=true yarn build:e2e && yarn migrate:e2e && wrangler dev --cwd dist --port $SERVER_PORT --var APP_SECRET:e2e-test-secret --persist-to ../node_modules/.wrangler-e2e",
    "migrate:e2e": "node scripts/migrate-e2e.mjs",
    "build:e2e": "DATABASE_URL=d1://emerald:00000000-0000-0000-0000-000000000000 alepha build"
  },
  "dependencies": {
    "alepha": "^0.27.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "better-sqlite3": "^13.0.3",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  },
  "dependenciesMeta": {
    "better-sqlite3": {
      "built": true
    }
  }
}
