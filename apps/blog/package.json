{
	"private": true,
	"type": "module",
	"dependencies": {
		"@mantine/core": "^8.1.1",
		"@mantine/form": "^8.1.1",
		"@mantine/hooks": "^8.1.1",
		"@mantine/nprogress": "^8.1.1",
		"@tabler/icons-react": "3.17.0",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@types/react": "^19.1.8",
		"drizzle-kit": "^0.31.2",
		"rolldown-vite": "^6.3.21",
		"vercel": "^44.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"start": "node --env-file=.env dist/index.mjs",
		"db:push": "node --env-file=.env scripts/db.ts --push",
		"db:push:prod": "node --env-file=.env.production scripts/db.ts --push",
		"db:generate": "drizzle-kit generate",
		"vercel:dev": "yarn vercel dev --cwd dist",
		"vercel:deploy": "yarn build && yarn vercel deploy --cwd dist",
		"vercel:deploy:prod": "yarn build && yarn vercel deploy --cwd dist --prod",
		"docker:build": "yarn build && docker compose build"
	}
}
