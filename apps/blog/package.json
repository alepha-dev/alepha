{
	"private": true,
	"type": "module",
	"dependencies": {
		"@mantine/core": "^8.2.2",
		"@mantine/form": "^8.2.2",
		"@mantine/hooks": "^8.2.2",
		"@mantine/nprogress": "^8.2.2",
		"@tabler/icons-react": "3.34.1",
		"react": "^19.1.1",
		"react-dom": "^19.1.1"
	},
	"devDependencies": {
		"@types/react": "^19.1.9",
		"@vitejs/plugin-react-oxc": "^0.3.0",
		"drizzle-kit": "^0.31.4",
		"rolldown-vite": "^7.0.12",
		"vercel": "^44.7.0",
		"vite-bundle-analyzer": "^1.1.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"start": "node --env-file=.env dist/index.mjs",
		"db:generate": "drizzle-kit generate",
		"db:migrate:prod": "node --env-file=.env.production scripts/migrate.ts",
		"vercel:dev": "yarn vercel dev --cwd dist",
		"vercel:deploy": "yarn build && yarn vercel deploy --cwd dist",
		"vercel:deploy:prod": "yarn build && yarn vercel deploy --cwd dist --prod",
		"docker:build": "yarn build && docker compose build"
	}
}
