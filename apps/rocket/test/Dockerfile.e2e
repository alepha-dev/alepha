# Overlay image that swaps the published `alepha` in /app/node_modules/
# for the local workspace's source. Built by test/e2e.sh — not for
# production use.
# Match the base image's platform — it was built with --platform
# linux/amd64 so the manifest only lists that arch.
FROM --platform=linux/amd64 alepha/rocket:latest

# The script `npm pack`s the local alepha workspace into this dir
# and `docker build` runs from that context.
COPY alepha.tgz /tmp/alepha.tgz

# `--force` overwrites the existing alepha. `--prefix /app` makes npm
# treat /app as the project root (where package.json + node_modules live).
RUN npm install --prefix /app --no-save --no-fund --no-audit --force \
      /tmp/alepha.tgz \
  && rm /tmp/alepha.tgz
