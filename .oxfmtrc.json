{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "sortImports": true,
  "sortTailwindcss": {
    "functions": ["cn", "clsx", "cva", "tw"]
  },
  "ignorePatterns": [
    "**/.playwright",
    "**/playwright-report",
    "**/test-results"
  ]
}
