{
  "name": "lore",
  "version": "0.37.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "alepha build --stats",
    "check:i18n": "alepha i18n check",
    "check:migrations": "alepha db migrations check",
    "db:generate": "alepha db migrations create",
    "build:docker": "alepha build && alepha image --tag",
    "image:release": "alepha image --push",
    "deploy": "alepha deploy -e production",
    "fonts": "node scripts/fetch-fonts.ts",
    "inventory": "node --import tsx --import ./scripts/css-stub.mjs scripts/print-app-inventory.ts",
    "start": "yarn build && LOG_LEVEL=trace LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "docs:corpus": "node scripts/generate-docs-corpus.ts"
  },
  "dependencies": {
    "@alepha/discord": "workspace:*",
    "@alepha/lore": "workspace:*",
    "@alepha/ui": "workspace:*",
    "@lore/chat": "workspace:*",
    "@lore/core": "workspace:*",
    "@lore/plan": "workspace:*",
    "@lore/plan-requirements": "workspace:*",
    "@lore/prompts": "workspace:*",
    "@lore/remember": "workspace:*",
    "@lore/ship": "workspace:*",
    "alepha": "workspace:*",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0",
    "ws": "^8.23.0"
  }
}
