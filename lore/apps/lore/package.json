{
  "name": "lore",
  "version": "0.32.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "alepha build --stats",
    "build&start": "alepha build && LOG_LEVEL=debug LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "check:i18n": "alepha i18n check",
    "check:migrations": "alepha db migrations check",
    "db:generate": "alepha db migrations create",
    "build:docker": "alepha build && alepha image --tag",
    "deploy": "alepha platform up -e production",
    "studio": "alepha db studio",
    "fonts": "node scripts/fetch-fonts.ts",
    "inventory": "node --import tsx --import ./scripts/css-stub.mjs scripts/print-app-inventory.ts",
    "start": "yarn build && LOG_LEVEL=trace LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "start:e2e": "alepha build --if-stale && DATABASE_URL=:memory: node dist",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@alepha/lore": "workspace:*",
    "@alepha/ui": "workspace:*",
    "@lore/core": "workspace:*",
    "@lore/deploy": "workspace:*",
    "@lore/knowledge": "workspace:*",
    "@lore/work": "workspace:*",
    "alepha": "workspace:*",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0",
    "ws": "^8.22.0"
  }
}
