{
  "name": "lore",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "alepha build --stats",
    "check:i18n": "alepha i18n check",
    "check:migrations": "alepha db migrations check",
    "db:generate": "alepha db migrations create",
    "build:docker": "alepha build && alepha image --tag",
    "deploy": "alepha deploy -e production",
    "fonts": "node scripts/fetch-fonts.ts",
    "inventory": "node --import tsx --import ./scripts/css-stub.mjs scripts/print-app-inventory.ts",
    "start": "yarn build && LOG_LEVEL=trace LOG_FORMAT=pretty DATABASE_URL=:memory: node dist"
  },
  "dependencies": {
    "@alepha/lore": "workspace:*",
    "@alepha/ui": "workspace:*",
    "@lore/core": "workspace:*",
    "@lore/deploy": "workspace:*",
    "@lore/knowledge": "workspace:*",
    "@lore/work": "workspace:*",
    "alepha": "workspace:*",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.150.0"
  }
}
