{
  "private": true,
  "name": "roadmap",
  "type": "module",
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "alepha build --stats",
    "build&start": "alepha build && LOG_LEVEL=debug LOG_FORMAT=pretty node dist",
    "db:generate": "alepha db migrations create",
    "build:docker": "alepha build --docker && cd dist && docker build -t alepha/roadmap .",
    "deploy": "alepha platform up -e production",
    "studio": "alepha db studio",
    "start": "yarn build && LOG_LEVEL=trace LOG_FORMAT=pretty DATABASE_URL=:memory: node dist",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/charts": "^9.0.1",
    "@mantine/core": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@mantine/modals": "^9.0.1",
    "@mantine/notifications": "^9.0.1",
    "@mantine/tiptap": "^9.0.1",
    "@tabler/icons-react": "^3.41.1",
    "@tiptap/core": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "alepha": "^0.19.3",
    "animate.css": "^4.1.1",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "konva": "^10.2.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "react-konva": "^19.2.3",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2",
    "vercel": "^50.41.0",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "wrangler": "^4.81.0"
  }
}
