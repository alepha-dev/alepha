{
  "name": "@alepha/lore",
  "version": "0.37.0",
  "description": "The Lore client for Alepha apps: the sigil reporter, and the CLI that talks to a Lore instance.",
  "keywords": [
    "alepha",
    "analytics",
    "cli",
    "errors",
    "lore",
    "observability",
    "sigil",
    "typescript"
  ],
  "homepage": "https://lore.alepha.app",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git",
    "directory": "lore/packages/@alepha/lore"
  },
  "bin": "./src/bin/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./sigil": {
      "types": "./src/sigil/index.ts",
      "browser": "./src/sigil/index.browser.ts",
      "import": "./src/sigil/index.ts",
      "default": "./src/sigil/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./csv": {
      "types": "./src/csv/index.ts",
      "import": "./src/csv/index.ts",
      "default": "./src/csv/index.ts"
    },
    "./playwright": {
      "types": "./src/playwright/index.ts",
      "import": "./src/playwright/index.ts",
      "default": "./src/playwright/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lore": "./dist/bin/index.js"
    },
    "exports": {
      "./sigil": {
        "types": "./dist/sigil/index.d.ts",
        "browser": "./dist/sigil/index.browser.js",
        "import": "./dist/sigil/index.js",
        "default": "./dist/sigil/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js",
        "default": "./dist/cli/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./csv": {
        "types": "./dist/csv/index.d.ts",
        "import": "./dist/csv/index.js",
        "default": "./dist/csv/index.js"
      },
      "./playwright": {
        "types": "./dist/playwright/index.d.ts",
        "import": "./dist/playwright/index.js",
        "default": "./dist/playwright/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "tsdown && node scripts/check-dts.ts && node scripts/check-bin.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alepha": "0.37.0",
    "js-yaml": "5.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "~1.3.3",
    "tsdown": "^0.23.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@lore/chat": "*",
    "@lore/core": "*",
    "@lore/plan": "*",
    "@lore/plan-requirements": "*",
    "@lore/prompts": "*",
    "@lore/remember": "*",
    "@lore/ship": "*",
    "@playwright/test": ">=1.42",
    "alepha": ">=0.37.0",
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "@lore/chat": {
      "optional": true
    },
    "@lore/core": {
      "optional": true
    },
    "@lore/plan": {
      "optional": true
    },
    "@lore/plan-requirements": {
      "optional": true
    },
    "@lore/prompts": {
      "optional": true
    },
    "@lore/remember": {
      "optional": true
    },
    "@lore/ship": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "alepha": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "llms": "https://alepha.dev/llms.txt"
}
