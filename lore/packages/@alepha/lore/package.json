{
  "name": "@alepha/lore",
  "version": "0.32.0",
  "description": "The Lore client for Alepha apps: the sigil reporter, and the CLI that talks to a Lore instance.",
  "keywords": [
    "alepha",
    "analytics",
    "cli",
    "errors",
    "lore",
    "observability",
    "sigil",
    "typescript"
  ],
  "homepage": "https://lore.alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/lore.git"
  },
  "bin": "./src/bin/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    "./sigil": {
      "types": "./src/sigil/index.ts",
      "browser": "./src/sigil/index.browser.ts",
      "import": "./src/sigil/index.ts",
      "default": "./src/sigil/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "bin": {
      "lore": "./dist/bin/index.js"
    },
    "exports": {
      "./sigil": {
        "types": "./dist/sigil/index.d.ts",
        "browser": "./dist/sigil/index.browser.js",
        "import": "./dist/sigil/index.js",
        "default": "./dist/sigil/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js",
        "default": "./dist/cli/index.js"
      },
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js",
        "default": "./dist/client/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "tsdown && node scripts/check-dts.ts && node scripts/check-bin.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "alepha": "0.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rolldown": "~1.2.11",
    "tsdown": "^0.23.0",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@lore/core": "*",
    "@lore/deploy": "*",
    "@lore/knowledge": "*",
    "@lore/work": "*",
    "alepha": "^0.30.0",
    "react": "*",
    "react-dom": "*"
  },
  "peerDependenciesMeta": {
    "@lore/core": {
      "optional": true
    },
    "@lore/deploy": {
      "optional": true
    },
    "@lore/knowledge": {
      "optional": true
    },
    "@lore/work": {
      "optional": true
    },
    "alepha": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "llms": "https://alepha.dev/llms.txt"
}
