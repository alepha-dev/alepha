{
  "name": "@alepha/sigil",
  "version": "0.20.1",
  "private": true,
  "description": "Reports page views, vitals and errors from an Alepha app to a Sigil instance.",
  "keywords": [
    "alepha",
    "analytics",
    "errors",
    "observability",
    "sigil",
    "typescript"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.browser.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": "./src/server/index.ts",
    "./ingest": "./src/ingest/index.ts",
    "./react": "./src/browser/react.ts",
    "./messages": "./src/shared/sigilMessages.ts",
    "./context": "./src/shared/sigilFeedbackContext.ts",
    "./feedback-position": "./src/shared/sigilFeedbackPosition.ts",
    "./vitals": "./src/shared/schemas/sigilVitalsBuckets.ts",
    "./fingerprint": "./src/shared/sigilFingerprint.ts",
    "./key": "./src/shared/sigilKey.ts",
    "./envelope": "./src/shared/schemas/sigilEnvelope.ts",
    "./config": "./src/shared/schemas/sigilConfig.ts",
    "./paths": "./src/shared/sigilPaths.ts",
    "./scrub": "./src/shared/sigilScrubUrl.ts"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "tsdown"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "alepha": "0.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
