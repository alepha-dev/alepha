{
	"private": true,
	"description": "Alepha framework monorepo workspace",
	"type": "module",
	"packageManager": "yarn@4.9.4",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/node": "^24.5.2",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"depcheck": "^1.4.7",
		"typescript": "^5.9.2",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"w": "yarn workspace",
		"v": "yarn alepha verify",
		"postinstall": "yarn copy",
		"alepha": "node apps/dev/src/index.ts",
		"clean": "yarn alepha clean",
		"copy": "yarn workspaces foreach -Apt run copy",
		"convert": "node scripts/convert.ts",
		"lint": "biome check --write --unsafe",
		"check": "yarn tsc --noEmit",
		"check-dependencies": "yarn workspaces foreach -Apt --exclude alepha --no-private exec depcheck --ignores=jsdom,@alepha/testing,shx,drizzle-kit,swagger-ui-dist --ignore-patterns=dist,assets",
		"test": "vitest run",
		"build": "yarn workspaces foreach -Apt run build"
	}
}
