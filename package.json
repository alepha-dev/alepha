{
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.9.1",
	"workspaces": {
		"packages": [
			"packages/*"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.15.3",
		"@vitest/coverage-v8": "^3.1.2",
		"@vitest/ui": "^3.1.2",
		"depcheck": "^1.4.7",
		"typescript": "^5.8.3",
		"vitest": "^3.1.2"
	},
	"scripts": {
		"a": "node scripts/index.ts",
		"v": "yarn a verify",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"convert": "node scripts/convert.ts",
		"check-dependencies": "yarn workspaces foreach -Apt --no-private exec depcheck --ignores=@alepha/testing,shx,vitest,drizzle-kit --ignore-patterns=dist,assets"
	}
}
