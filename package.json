{
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.9.1",
	"workspaces": {
		"packages": [
			"packages/*"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.15.17",
		"@vitest/coverage-v8": "^3.1.3",
		"@vitest/ui": "^3.1.3",
		"depcheck": "^1.4.7",
		"typescript": "^5.8.3",
		"vitest": "^3.1.3"
	},
	"scripts": {
		"alepha": "node scripts/index.ts",
		"verify": "yarn alepha verify",
		"format": "biome format --write",
		"lint": "biome lint --write",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"convert": "node scripts/convert.ts",
		"check-dependencies": "yarn workspaces foreach -Apt --no-private exec depcheck --ignores=@alepha/testing,shx,vitest,drizzle-kit,swagger-ui-dist --ignore-patterns=dist,assets"
	}
}
