{
  "name": "alepha-monorepo",
  "private": true,
  "description": "Alepha framework monorepo workspace",
  "workspaces": {
    "packages": [
      "packages/**/*",
      "apps/**/*",
      "!apps/**/*/dist"
    ]
  },
  "type": "module",
  "scripts": {
    "w": "yarn workspace",
    "a": "yarn alepha",
    "v": "yarn alepha verify",
    "verify": "yarn alepha verify",
    "verify:go": "yarn alepha verify:go",
    "v:go": "yarn alepha verify:go",
    "clean": "yarn alepha clean",
    "copy": "yarn workspaces foreach -Apt run copy && yarn lint",
    "lint": "yarn alepha lint",
    "typecheck": "tsc --noEmit && yarn workspaces foreach -Apt --exclude alepha-monorepo -j 4 run typecheck",
    "test": "yarn vitest run",
    "check:deps": "yarn workspaces foreach -Apt exec depcheck .",
    "check:conventions": "node scripts/check-conventions.ts",
    "check:docs": "yarn workspaces foreach -Apt run check:docs",
    "check:i18n": "yarn workspaces foreach -Apt run check:i18n",
    "check:migrations": "yarn workspaces foreach -Apt run check:migrations",
    "build": "yarn workspaces foreach -Apt run build",
    "test:bun": "bun test ./packages/**/*.bun.spec.ts",
    "e2e": "yarn workspaces foreach -Apt run e2e",
    "e2e-cli": "yarn w e2e-cli test"
  },
  "devDependencies": {
    "@alepha/lore": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "alepha": "^0.29.0",
    "depcheck": "^1.4.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "workerd": {
      "built": true
    }
  },
  "packageManager": "yarn@4.18.0"
}
