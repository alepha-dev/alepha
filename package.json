{
	"private": true,
	"description": "Alepha framework monorepo workspace",
	"type": "module",
	"packageManager": "yarn@4.10.3",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"!apps/*/dist"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
		"@types/node": "^24.9.2",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"depcheck": "^1.4.7",
		"typescript": "^5.9.3",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"w": "yarn workspace",
		"v": "yarn alepha verify",
		"verify": "yarn alepha verify",
		"postinstall": "yarn copy && yarn lint",
		"alepha": "node apps/dev/src/index.ts",
		"clean": "yarn alepha clean",
		"copy": "yarn workspaces foreach -Apt run copy",
		"convert": "node scripts/convert.ts",
		"lint": "biome check --write --unsafe",
		"typecheck": "yarn tsc --noEmit",
		"check-dependencies": "yarn workspaces foreach -Apt --exclude alepha --exclude @alepha/cli --no-private exec depcheck --ignores=jsdom,@alepha/testing,shx,drizzle-kit,swagger-ui-dist,vite --ignore-patterns=dist,assets",
		"test": "vitest run",
		"build": "yarn workspaces foreach -Apt run build"
	}
}
