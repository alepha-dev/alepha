{
	"private": true,
	"type": "module",
	"packageManager": "yarn@4.9.2",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@types/node": "^24.0.10",
		"@vitest/coverage-v8": "^3.2.4",
		"@vitest/ui": "^3.2.4",
		"depcheck": "^1.4.7",
		"typescript": "^5.8.3",
		"vite-plugin-dts": "^4.5.4",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"v": "yarn alepha verify",
		"postinstall": "yarn copy",
		"alepha": "node scripts/index.ts",
		"clean": "yarn alepha clean",
		"copy": "yarn workspaces foreach -Apt --no-private run copy",
		"convert": "node scripts/convert.ts",
		"format": "biome format --write",
		"lint": "biome check --write --formatter-enabled=false ",
		"check": "tsc --noEmit",
		"check-dependencies": "yarn workspaces foreach -Apt --exclude alepha --no-private exec depcheck --ignores=@alepha/testing,shx,drizzle-kit,swagger-ui-dist --ignore-patterns=dist,assets",
		"test": "vitest run",
		"build": "yarn workspaces foreach -Apt --no-private run build"
	}
}
