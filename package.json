{
  "private": true,
  "name": "alepha-monorepo",
  "description": "Alepha framework monorepo workspace",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "workspaces": {
    "packages": [
      "packages/**/*",
      "apps/**/*",
      "!apps/**/*/dist"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "alepha": "^0.19.0",
    "depcheck": "^1.4.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "w": "yarn workspace",
    "a": "yarn alepha",
    "v": "yarn alepha verify",
    "verify": "yarn alepha verify",
    "clean": "yarn alepha clean",
    "copy": "yarn workspaces foreach -Apt run copy",
    "convert": "node scripts/convert.ts",
    "lint": "yarn alepha lint",
    "typecheck": "yarn workspaces foreach -Apt run typecheck",
    "test": "yarn vitest run",
    "check-dependencies": "yarn workspaces foreach -Apt exec depcheck .",
    "build": "yarn workspaces foreach -Apt run build",
    "test:bun": "bun test ./**/*.bun.spec.ts",
    "e2e": "yarn workspaces foreach -Apt run e2e",
    "e2e-cli": "yarn w e2e-cli test"
  }
}
