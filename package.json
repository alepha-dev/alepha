{
	"private": true,
	"description": "Alepha framework monorepo workspace",
	"type": "module",
	"packageManager": "yarn@4.12.0",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"!apps/*/dist"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@types/node": "^24.10.1",
		"@vitest/coverage-v8": "^4.0.14",
		"@vitest/ui": "^4.0.14",
		"depcheck": "^1.4.7",
		"typescript": "^5.9.3",
		"vitest": "^4.0.14"
	},
	"scripts": {
		"alepha": "node scripts/alepha-dev-cli.ts",
		"w": "yarn workspace",
		"v": "yarn alepha verify",
		"verify": "yarn alepha verify",
		"postinstall": "yarn copy && yarn lint",
		"clean": "yarn alepha clean",
		"copy": "yarn workspaces foreach -Apt run copy",
		"convert": "node scripts/convert.ts",
		"lint": "biome check --fix",
		"typecheck": "yarn tsc --noEmit",
		"check-dependencies": "yarn workspaces foreach -Apt --exclude alepha --no-private exec depcheck --ignores=@vitejs/plugin-react,jsdom,@alepha/ui,@alepha/react,shx,drizzle-kit,swagger-ui-dist,vite,@types/react --ignore-patterns=dist,assets",
		"test": "vitest run",
		"build": "yarn workspaces foreach -Apt run build"
	}
}
