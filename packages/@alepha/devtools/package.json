{
  "name": "@alepha/devtools",
  "description": "Developer tools for Alepha applications.",
  "keywords": [
    "alepha",
    "devtools"
  ],
  "author": "Feunard",
  "version": "0.24.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "devDependencies": {
    "@alepha/ui": "workspace:^",
    "@biomejs/biome": "^2.5.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@xyflow/react": "^12.11.2",
    "alepha": "0.24.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "alepha": "0.24.0"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "dev:ui": "alepha dev --no-devtools",
    "build": "yarn build:ui && tsdown --no-clean",
    "build:ui": "alepha build -t static && rm -rf assets/ui && mkdir -p assets && cp -r dist/public assets/ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.browser.ts",
      "browser": "./src/index.browser.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "react-native": "./dist/index.browser.js",
        "browser": "./dist/index.browser.js",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
