{
  "name": "@alepha/devtools",
  "description": "Developer tools for Alepha applications.",
  "keywords": [
    "alepha",
    "devtools"
  ],
  "author": "Feunard",
  "version": "0.19.4",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "devDependencies": {
    "@alepha/ui": "0.19.4",
    "@biomejs/biome": "^2.4.11",
    "@mantine/core": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@tabler/icons-react": "^3.41.1",
    "@xyflow/react": "^12.10.2",
    "alepha": "0.19.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "alepha": "0.19.4"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "dev:ui": "alepha dev --no-devtools",
    "build": "tsdown && yarn build:ui",
    "build:ui": "alepha build -t static && rm -rf assets/ui && mkdir -p assets && cp -r dist/public assets/ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.browser.ts",
      "browser": "./src/index.browser.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  }
}
