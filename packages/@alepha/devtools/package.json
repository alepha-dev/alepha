{
  "name": "@alepha/devtools",
  "version": "0.31.0",
  "description": "Alepha DevTools: every app running on this machine, inspected from one place. Run it with npx @alepha/devtools.",
  "keywords": [
    "alepha",
    "devtools",
    "typescript"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git"
  },
  "bin": {
    "alepha-devtools": "./dist/bin.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "dev:ui": "ALEPHA_INSPECT=0 alepha dev",
    "build": "yarn build:ui && tsdown --no-clean",
    "build:ui": "alepha build --runtime static && rm -rf assets/ui && mkdir -p assets && cp -r dist/public assets/ui && rm -rf dist"
  },
  "dependencies": {
    "alepha": "0.31.0"
  },
  "devDependencies": {
    "@alepha/ui": "workspace:^",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@xyflow/react": "^12.12.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "llms": "https://alepha.dev/llms.txt"
}
