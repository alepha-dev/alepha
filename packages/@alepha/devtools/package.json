{
  "name": "@alepha/devtools",
  "description": "Developer tools for Alepha applications.",
  "keywords": [
    "alepha",
    "devtools"
  ],
  "author": "Nicolas Foures",
  "version": "0.19.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "devDependencies": {
    "@alepha/ui": "0.19.0",
    "@biomejs/biome": "^2.4.8",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tabler/icons-react": "^3.40.0",
    "@xyflow/react": "^12.10.1",
    "alepha": "0.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "alepha": "0.19.0"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "dev:ui": "alepha dev --no-devtools",
    "build": "tsdown",
    "build:ui": "alepha build -t static && rm -rf assets/ui && cp -r dist/public assets/ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.browser.ts",
      "browser": "./src/index.browser.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
