{
  "name": "@alepha/capacitor",
  "version": "0.31.0",
  "description": "Native iOS and Android apps for Alepha: a Capacitor shell, native capabilities behind DI providers, and the alepha capacitor commands.",
  "keywords": [
    "alepha",
    "android",
    "capacitor",
    "ios",
    "mobile",
    "typescript"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./cli": {
      "types": "./src/cli/index.ts",
      "import": "./src/cli/index.ts",
      "default": "./src/cli/index.ts"
    },
    "./ota": {
      "types": "./src/ota/index.ts",
      "import": "./src/ota/index.ts",
      "default": "./src/ota/index.ts"
    },
    "./ota-api": {
      "types": "./src/ota-api/index.ts",
      "import": "./src/ota-api/index.ts",
      "default": "./src/ota-api/index.ts"
    },
    "./ota-admin": {
      "types": "./src/ota-admin/index.ts",
      "import": "./src/ota-admin/index.ts",
      "default": "./src/ota-admin/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/core/index.js",
    "types": "./dist/core/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "default": "./dist/core/index.js"
      },
      "./core": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "default": "./dist/core/index.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js",
        "default": "./dist/cli/index.js"
      },
      "./ota": {
        "types": "./dist/ota/index.d.ts",
        "import": "./dist/ota/index.js",
        "default": "./dist/ota/index.js"
      },
      "./ota-api": {
        "types": "./dist/ota-api/index.d.ts",
        "import": "./dist/ota-api/index.js",
        "default": "./dist/ota-api/index.js"
      },
      "./ota-admin": {
        "types": "./dist/ota-admin/index.d.ts",
        "import": "./dist/ota-admin/index.js",
        "default": "./dist/ota-admin/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "alepha test",
    "typecheck": "tsc --noEmit"
  },
