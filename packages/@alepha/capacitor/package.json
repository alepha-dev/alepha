    "@capacitor/core": "8.5.2",
    "@capacitor/device": "8.0.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/capacitor-updater": "8.52.1",
    "@capgo/cli": "8.75.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "alepha": "0.31.0",
    "react": "^19.3.0",
    "rolldown": "~1.2.12",
