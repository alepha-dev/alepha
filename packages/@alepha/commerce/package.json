{
  "name": "@alepha/commerce",
  "private": true,
  "description": "Headless commerce for Alepha apps: catalog, cart, checkout. Extended by product-kind handlers.",
  "keywords": [
    "alepha",
    "cart",
    "catalog",
    "checkout",
    "commerce",
    "ecommerce",
    "typescript"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vat": "./src/services/VatCalculator.ts",
    "./cart": "./src/cart/index.ts",
    "./checkout": "./src/checkout/index.ts",
    "./shipping": "./src/shipping/index.ts",
    "./invoicing": "./src/invoicing/index.ts",
    "./notifications": "./src/notifications/index.ts",
    "./settlement": "./src/settlement/index.ts",
    "./recovery": "./src/recovery/index.ts",
    "./admin": "./src/admin/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles.css",
    "./admin/components/*": "./src/admin/components/*.tsx",
    "./checkout/components/*": "./src/checkout/components/*",
    "./shipping/components/*": "./src/shipping/components/*.tsx"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "tsdown"
  },
  "dependencies": {
    "@alepha/ui": "workspace:*",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "alepha": "0.27.0",
    "react": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "alepha": "^0.27.0",
    "react": "*"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "llms": "https://alepha.dev/llms.txt"
}
