{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/registry/*": ["./registry/*"],
      "@/components/*": ["./stub/components/*"],
      "@/lib/*": ["./stub/lib/*"],
      "sonner": ["./stub/sonner.ts"]
    }
  },
  "include": ["registry", "stub"]
}
