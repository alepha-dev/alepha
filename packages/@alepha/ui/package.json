{
  "name": "@alepha/ui",
  "version": "0.29.0",
  "description": "Shared Base UI and Tailwind components for Alepha apps. Edited directly; bugfixes propagate via normal dep updates.",
  "keywords": [
    "alepha",
    "base-ui",
    "react",
    "tailwind",
    "typescript",
    "ui"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/core/index.ts",
    "./form": "./src/form/index.ts",
    "./settings": "./src/settings/index.ts",
    "./table": "./src/table/index.ts",
    "./tree": "./src/tree/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./shell": "./src/shell/index.ts",
    "./auth": "./src/auth/index.ts",
    "./account": "./src/account/index.ts",
    "./admin": "./src/admin/index.ts",
    "./organizations": "./src/organizations/index.ts",
    "./chart": "./src/chart/index.ts",
    "./command": "./src/command/index.ts",
    "./calendar": "./src/calendar/index.ts",
    "./otp": "./src/otp/index.ts",
    "./resizable": "./src/resizable/index.ts",
    "./i18n/fr": "./src/i18n/fr/index.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "./form": {
        "types": "./dist/form/index.d.ts",
        "default": "./dist/form/index.js"
      },
      "./settings": {
        "types": "./dist/settings/index.d.ts",
        "default": "./dist/settings/index.js"
      },
      "./table": {
        "types": "./dist/table/index.d.ts",
        "default": "./dist/table/index.js"
      },
      "./tree": {
        "types": "./dist/tree/index.d.ts",
        "default": "./dist/tree/index.js"
      },
      "./markdown": {
        "types": "./dist/markdown/index.d.ts",
        "default": "./dist/markdown/index.js"
      },
      "./shell": {
        "types": "./dist/shell/index.d.ts",
        "default": "./dist/shell/index.js"
      },
      "./auth": {
        "types": "./dist/auth/index.d.ts",
        "default": "./dist/auth/index.js"
      },
      "./account": {
        "types": "./dist/account/index.d.ts",
        "default": "./dist/account/index.js"
      },
      "./admin": {
        "types": "./dist/admin/index.d.ts",
        "default": "./dist/admin/index.js"
      },
      "./organizations": {
        "types": "./dist/organizations/index.d.ts",
        "default": "./dist/organizations/index.js"
      },
      "./chart": {
        "types": "./dist/chart/index.d.ts",
        "default": "./dist/chart/index.js"
      },
      "./command": {
        "types": "./dist/command/index.d.ts",
        "default": "./dist/command/index.js"
      },
      "./calendar": {
        "types": "./dist/calendar/index.d.ts",
        "default": "./dist/calendar/index.js"
      },
      "./otp": {
        "types": "./dist/otp/index.d.ts",
        "default": "./dist/otp/index.js"
      },
      "./resizable": {
        "types": "./dist/resizable/index.d.ts",
        "default": "./dist/resizable/index.js"
      },
      "./i18n/fr": {
        "types": "./dist/i18n/fr/index.d.ts",
        "default": "./dist/i18n/fr/index.js"
      },
      "./styles.css": "./src/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json && node scripts/copy-css.ts",
    "test": "alepha test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "graphre": "^0.1.3",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.12.0",
    "input-otp": "^1.5.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.43.0",
    "react-day-picker": "^10.0.1",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "alepha": "0.29.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "alepha": "^0.29.0",
    "react": "*",
    "react-dom": "*",
    "recharts": "^3",
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "llms": "https://alepha.dev/llms.txt"
}
