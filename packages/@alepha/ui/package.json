{
  "name": "@alepha/ui",
  "description": "UI components and themes for Alepha framework based on Mantine UI library.",
  "keywords": [
    "alepha",
    "ui",
    "mantine"
  ],
  "author": "Feunard",
  "version": "0.19.3",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "style": "./styles.css",
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "dependencies": {
    "@mantine/core": "^9.0.1",
    "@mantine/dates": "^9.0.1",
    "@mantine/hooks": "^9.0.1",
    "@mantine/modals": "^9.0.1",
    "@mantine/notifications": "^9.0.1",
    "@mantine/nprogress": "^9.0.1",
    "@mantine/spotlight": "^9.0.1",
    "@tabler/icons-react": "^3.41.1",
    "dayjs": "^1.11.20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react-is": "^19.2.0",
    "alepha": "0.19.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "peerDependencies": {
    "alepha": "0.19.3",
    "react": "*",
    "react-dom": "*"
  },
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint && yarn build:check",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "node ../../alepha/scripts/build.ts",
    "build:check": "node ../../alepha/scripts/build.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    "./admin": {
      "types": "./src/admin/index.ts",
      "import": "./src/admin/index.ts",
      "default": "./src/admin/index.ts"
    },
    "./admin-audits": {
      "types": "./src/admin-audits/index.ts",
      "import": "./src/admin-audits/index.ts",
      "default": "./src/admin-audits/index.ts"
    },
    "./admin-files": {
      "types": "./src/admin-files/index.ts",
      "import": "./src/admin-files/index.ts",
      "default": "./src/admin-files/index.ts"
    },
    "./admin-jobs": {
      "types": "./src/admin-jobs/index.ts",
      "import": "./src/admin-jobs/index.ts",
      "default": "./src/admin-jobs/index.ts"
    },
    "./admin-keys": {
      "types": "./src/admin-keys/index.ts",
      "import": "./src/admin-keys/index.ts",
      "default": "./src/admin-keys/index.ts"
    },
    "./admin-notifications": {
      "types": "./src/admin-notifications/index.ts",
      "import": "./src/admin-notifications/index.ts",
      "default": "./src/admin-notifications/index.ts"
    },
    "./admin-parameters": {
      "types": "./src/admin-parameters/index.ts",
      "import": "./src/admin-parameters/index.ts",
      "default": "./src/admin-parameters/index.ts"
    },
    "./admin-payments": {
      "types": "./src/admin-payments/index.ts",
      "import": "./src/admin-payments/index.ts",
      "default": "./src/admin-payments/index.ts"
    },
    "./admin-sessions": {
      "types": "./src/admin-sessions/index.ts",
      "import": "./src/admin-sessions/index.ts",
      "default": "./src/admin-sessions/index.ts"
    },
    "./admin-users": {
      "types": "./src/admin-users/index.ts",
      "import": "./src/admin-users/index.ts",
      "default": "./src/admin-users/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./demo": {
      "types": "./src/demo/index.ts",
      "import": "./src/demo/index.ts",
      "default": "./src/demo/index.ts"
    },
    "./styles": "./src/core/styles.css",
    "./styles.css": "./src/core/styles.css"
  }
}
