{
  "name": "@alepha/ui",
  "private": true,
  "description": "Shared shadcn-based UI for Alepha apps in this monorepo. Sourced from @alepha/ui-registry; consumed by apps as a workspace package.",
  "author": "Feunard",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles.css": "./src/styles.css"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "alepha": "workspace:^",
    "react": "*",
    "react-dom": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "alepha": "workspace:^",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3"
  }
}
