{
  "name": "@alepha/protobuf",
  "description": "Protocol Buffers (Protobuf) codec support for Alepha framework.",
  "author": "Nicolas Foures",
  "version": "0.25.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "protobufjs": "^8.7.2"
  },
  "dependenciesMeta": {
    "protobufjs": {
      "built": true
    }
  },
  "devDependencies": {
    "alepha": "0.25.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "alepha": "^0.25.2"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "tsdown"
  },
  "homepage": "https://alepha.dev",
  "llms": "https://alepha.dev/llms.txt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "keywords": [
    "alepha",
    "protobuf",
    "zod",
    "codec",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
