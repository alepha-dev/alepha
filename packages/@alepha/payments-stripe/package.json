{
  "name": "@alepha/payments-stripe",
  "description": "Stripe payment provider for alepha/payments.",
  "keywords": [
    "alepha",
    "payments",
    "stripe"
  ],
  "author": "Feunard",
  "version": "0.20.3",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "alepha": "0.20.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "alepha": "0.20.3"
  },
  "scripts": {
    "lint": "alepha lint && yarn build:check",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "node ../../alepha/scripts/build.ts",
    "build:check": "node ../../alepha/scripts/build.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./platform": {
      "types": "./src/platform/index.ts",
      "import": "./src/platform/index.ts",
      "default": "./src/platform/index.ts"
    }
  }
}
