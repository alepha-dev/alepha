{
  "name": "@alepha/payments-stripe",
  "description": "Stripe payment provider for alepha/payments.",
  "keywords": [
    "alepha",
    "payments",
    "stripe"
  ],
  "author": "Feunard",
  "version": "0.25.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "alepha": "0.25.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "alepha": "0.25.2"
  },
  "scripts": {
    "lint": "alepha lint && yarn build:check",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "node ../../alepha/scripts/build.ts",
    "build:check": "node ../../alepha/scripts/build.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/core/index.js",
    "types": "./dist/core/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "default": "./dist/core/index.js"
      }
    }
  }
}
