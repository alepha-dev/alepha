{
  "name": "@alepha/rocket",
  "private": true,
  "description": "Remote `alepha platform` runner — controller + types for the Rocket container image.",
  "keywords": [
    "alepha",
    "rocket",
    "deploy",
    "cloudflare"
  ],
  "author": "Feunard",
  "version": "0.21.2",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "s3mini": "^0.9.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "alepha": "0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "alepha": "0.22.0"
  },
  "scripts": {
    "lint": "alepha lint && yarn build:check",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "node ../../alepha/scripts/build.ts",
    "build:check": "node ../../alepha/scripts/build.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/core/index.js",
    "types": "./dist/core/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/core/index.d.ts",
        "import": "./dist/core/index.js",
        "default": "./dist/core/index.js"
      }
    }
  }
}
