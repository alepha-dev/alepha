{
  "extends": "alepha/tsconfig.base",
  "compilerOptions": {
    "types": ["node", "bun"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@alepha/lore/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts"]
}
