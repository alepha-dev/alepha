{
	"name": "@alepha/devtools",
	"description": "Developer tools for monitoring and debugging Alepha applications.",
	"version": "0.11.5",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@alepha/bucket": "0.11.5",
		"@alepha/cache": "0.11.5",
		"@alepha/core": "0.11.5",
		"@alepha/logger": "0.11.5",
		"@alepha/postgres": "0.11.5",
		"@alepha/queue": "0.11.5",
		"@alepha/react": "0.11.5",
		"@alepha/react-i18n": "0.11.5",
		"@alepha/scheduler": "0.11.5",
		"@alepha/security": "0.11.5",
		"@alepha/server": "0.11.5",
		"@alepha/server-static": "0.11.5",
		"@alepha/topic": "0.11.5"
	},
	"devDependencies": {
		"@alepha/cli": "0.11.5",
		"@alepha/ui": "0.11.5",
		"@alepha/vite": "0.11.5",
		"@biomejs/biome": "^2.3.4",
		"@tabler/icons-react": "^3.35.0",
		"react": "^19.2.0",
		"tsdown": "^0.16.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.7"
	},
	"scripts": {
		"test": "vitest run",
		"lint": "biome check --fix",
		"build:ui": "alepha build && rm -r assets/devtools && cp -r dist/public assets/devtools",
		"build": "yarn ui:build && tsdown -c=../../tsdown.config.ts",
		"typecheck": "tsc --noEmit",
		"ui:dev": "alepha dev",
		"ui:build": "alepha build && rm -r assets/devtools && cp -r dist/public assets/devtools"
	},
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"keywords": [
		"alepha",
		"devtools",
		"monitoring",
		"debugging"
	]
}
