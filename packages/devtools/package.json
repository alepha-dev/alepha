	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@alepha/bucket": "0.11.2",
		"@alepha/cache": "0.11.2",
		"@alepha/core": "0.11.2",
		"@alepha/logger": "0.11.2",
		"@alepha/queue": "0.11.2",
		"@alepha/react": "0.11.2",
		"@alepha/scheduler": "0.11.2",
		"@alepha/security": "0.11.2",
		"@alepha/server": "0.11.2",
		"@alepha/topic": "0.11.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.2",
