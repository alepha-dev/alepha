{
	"name": "@alepha/devtools",
	"description": "Developer tools for monitoring and debugging Alepha applications.",
	"version": "0.11.11",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"dist",
		"src"
	],
	"devDependencies": {
		"@alepha/react": "0.11.11",
		"@alepha/ui": "0.11.11",
		"@tabler/icons-react": "^3.35.0",
		"alepha": "0.11.11",
		"react": "^19.2.0",
		"tsdown": "^0.16.4",
		"vitest": "^4.0.9"
	},
	"peerDependencies": {
		"alepha": "0.11.11"
	},
	"scripts": {
		"copy": "yarn ui:build",
		"lint": "alepha lint",
		"typecheck": "alepha typecheck",
		"test": "alepha test",
		"build": "yarn ui:build && tsdown -c=../../tsdown.config.ts",
		"ui:dev": "alepha dev",
		"ui:build": "alepha build && rm -rf assets/devtools && cp -r dist/public assets/devtools"
	},
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"keywords": [
		"alepha",
		"devtools",
		"monitoring",
		"debugging"
	]
}
