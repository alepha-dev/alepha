{
  "name": "@alepha/ui",
  "description": "UI components and themes for Alepha framework based on Mantine UI library.",
  "keywords": [
    "alepha",
    "ui",
    "mantine"
  ],
  "author": "Nicolas Foures",
  "version": "0.13.7",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "style": "./styles.css",
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "dependencies": {
    "@alepha/react": "0.13.7",
    "@mantine/core": "^8.3.10",
    "@mantine/dates": "^8.3.10",
    "@mantine/hooks": "^8.3.10",
    "@mantine/modals": "^8.3.10",
    "@mantine/notifications": "^8.3.10",
    "@mantine/nprogress": "^8.3.10",
    "@mantine/spotlight": "^8.3.10",
    "@tabler/icons-react": "^3.35.0",
    "alepha": "0.13.7",
    "dayjs": "^1.11.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "node scripts/build.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    "./admin": {
      "types": "./src/admin/index.ts",
      "import": "./src/admin/index.ts",
      "default": "./src/admin/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./styles": "./styles.css"
  }
}
