{
  "name": "@alepha/ui",
  "description": "UI components and themes for Alepha framework based on Mantine UI library.",
  "keywords": [
    "alepha",
    "ui",
    "mantine"
  ],
  "author": "Nicolas Foures",
  "version": "0.18.3",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "style": "./styles.css",
  "files": [
    "dist",
    "src",
    "styles.css"
  ],
  "dependencies": {
    "@mantine/charts": "^8.3.16",
    "@mantine/core": "^8.3.16",
    "@mantine/dates": "^8.3.16",
    "@mantine/hooks": "^8.3.16",
    "@mantine/modals": "^8.3.16",
    "@mantine/notifications": "^8.3.16",
    "@mantine/nprogress": "^8.3.16",
    "@mantine/spotlight": "^8.3.16",
    "@tabler/icons-react": "^3.40.0",
    "dayjs": "^1.11.20",
    "react-is": "^19.2.4",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react-is": "^19.2.0",
    "alepha": "0.18.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "alepha": "0.18.3",
    "react": "*",
    "react-dom": "*"
  },
  "scripts": {
    "dev": "alepha dev",
    "lint": "alepha lint && yarn build:check",
    "typecheck": "alepha typecheck",
    "test": "alepha test",
    "build": "node ../alepha/scripts/build.ts",
    "build:check": "node ../alepha/scripts/build.ts --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "homepage": "https://github.com/feunard/alepha",
  "exports": {
    "./admin": {
      "types": "./src/admin/index.ts",
      "import": "./src/admin/index.ts",
      "default": "./src/admin/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./demo": {
      "types": "./src/demo/index.ts",
      "import": "./src/demo/index.ts",
      "default": "./src/demo/index.ts"
    },
    "./styles": "./src/core/styles.css",
    "./styles.css": "./src/core/styles.css"
  }
}
