{
  "name": "create-alepha",
  "version": "0.28.0",
  "description": "Create a new Alepha project with a single command.",
  "keywords": [
    "alepha",
    "create",
    "framework",
    "scaffold",
    "typescript"
  ],
  "homepage": "https://alepha.dev",
  "license": "MIT",
  "author": "Nicolas Foures",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alepha-dev/alepha.git"
  },
  "bin": "./src/index.ts",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "bin": "./dist/index.js",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsdown"
  },
  "devDependencies": {
    "alepha": "0.28.0",
    "tsdown": "^0.22.14",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "llms": "https://alepha.dev/llms.txt"
}
