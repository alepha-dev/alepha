{
	"name": "@alepha/server-cookies",
	"description": "Type-safe HTTP cookie parsing and serialization for servers.",
	"version": "0.11.8",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"browser": {
		"./dist/index.js": "./dist/index.browser.js"
	},
	"files": [
		"dist",
		"src"
	],
	"dependencies": {
		"@alepha/core": "0.11.8",
		"@alepha/datetime": "0.11.8",
		"@alepha/logger": "0.11.8",
		"@alepha/security": "0.11.8",
		"@alepha/server": "0.11.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"tsdown": "^0.16.4",
		"typescript": "^5.9.3",
		"vitest": "^4.0.8"
	},
	"scripts": {
		"lint": "biome check --fix",
		"build": "tsdown -c=../../tsdown.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"keywords": [
		"alepha",
		"server",
		"cookies"
	],
	"module": "./dist/index.js",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"browser": "./dist/index.browser.js"
		}
	}
}
