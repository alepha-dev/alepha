{
	"name": "@alepha/server-swagger",
	"description": "Generates OpenAPI documentation and a Swagger UI for APIs.",
	"version": "0.8.0",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"dist",
		"src",
		"assets"
	],
	"dependencies": {
		"@alepha/core": "0.8.0",
		"@alepha/security": "0.8.0",
		"@alepha/server": "0.8.0",
		"@alepha/server-static": "0.8.0",
		"openapi-types": "^12.1.3"
	},
	"devDependencies": {
		"swagger-ui-dist": "^5.26.2",
		"tsdown": "^0.12.9",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"copy": "node scripts/copy.ts",
		"test": "vitest run",
		"build": "tsdown -c ../../tsdown.config.ts && yarn copy"
	},
	"scarfSettings": {
		"enabled": false
	},
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"keywords": [
		"alepha",
		"server",
		"swagger",
		"openapi"
	]
}
