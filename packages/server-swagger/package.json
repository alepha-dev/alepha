{
	"name": "@alepha/server-swagger",
	"description": "Generates OpenAPI documentation and a Swagger UI for APIs.",
	"version": "0.10.1",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"dist",
		"src",
		"assets"
	],
	"dependencies": {
		"@alepha/core": "0.10.1",
		"@alepha/logger": "0.10.1",
		"@alepha/security": "0.10.1",
		"@alepha/server": "0.10.1",
		"@alepha/server-security": "0.10.1",
		"@alepha/server-static": "0.10.1",
		"openapi-types": "^12.1.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"swagger-ui-dist": "^5.29.1",
		"tsdown": "^0.15.6",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"scripts": {
		"copy": "node scripts/copy.ts",
		"test": "vitest run",
		"lint": "biome check --write --unsafe",
		"build": "tsdown -c ../../tsdown.config.ts && yarn copy",
		"check": "tsc"
	},
	"scarfSettings": {
		"enabled": false
	},
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"keywords": [
		"alepha",
		"server",
		"swagger",
		"openapi"
	]
}
