{
	"name": "@alepha/server-swagger",
	"version": "0.6.4",
	"type": "module",
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": ["dist", "src", "assets"],
	"dependencies": {
		"@alepha/core": "0.6.4",
		"@alepha/security": "0.6.4",
		"@alepha/server": "0.6.4",
		"@alepha/server-static": "0.6.4",
		"openapi-types": "^12.1.3"
	},
	"devDependencies": {
		"pkgroll": "^2.12.2",
		"swagger-ui-dist": "^5.21.0",
		"vitest": "^3.1.3",
		"zx": "^8.5.4"
	},
	"scripts": {
		"copy": "node scripts/copy.ts",
		"build": "pkgroll --clean-dist --sourcemap && yarn copy"
	},
	"scarfSettings": {
		"enabled": false
	},
	"publishConfig": {
		"main": "./dist/index.cjs",
		"types": "./dist/index.d.ts",
		"module": "./dist/index.js",
		"exports": {
			".": {
				"import": "./dist/index.js",
				"require": "./dist/index.cjs",
				"types": "./dist/index.d.ts"
			}
		}
	}
}
