{
  "name": "@alepha/cache",
  "description": "Cache module for Alepha - supports Redis and in-memory cache",
  "keywords": [
    "alepha",
    "cache",
    "redis",
    "in-memory"
  ],
  "author": "Feunard",
  "version": "0.6.3",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/index.js": "./dist/index.browser.js"
  },
  "dependencies": {
    "@alepha/core": "0.6.3",
    "@alepha/redis": "0.6.3"
  },
  "devDependencies": {
    "pkgroll": "^2.12.2",
    "vitest": "^3.1.3"
  },
  "scripts": {
    "build": "pkgroll --clean-dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/feunard/alepha"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.browser.js"
    }
  }
}
