{
	"name": "@alepha/react",
	"description": "React components and hooks for building Alepha applications.",
	"version": "0.11.11",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"files": [
		"dist",
		"src",
		"assets"
	],
	"bin": "./src/index.ts",
	"devDependencies": {
		"@types/react": "^19.2.5",
		"alepha": "0.11.11",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"peerDependencies": {
		"alepha": "0.11.11",
		"react": "^19.2.0"
	},
	"scripts": {
		"lint": "biome check --fix",
		"build": "node scripts/build.ts",
		"check": "tsc --noEmit"
	},
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"keywords": [
		"alepha",
		"aleph",
		"framework",
		"serverless",
		"react",
		"api"
	],
	"exports": {
		".": {
			"import": "./src/core/index.ts",
			"require": "./src/core/index.ts",
			"types": "./src/core/index.ts",
			"browser": "./src/core/index.browser.ts"
		},
		"./auth": {
			"import": "./src/react-auth/index.ts",
			"require": "./src/react-auth/index.ts",
			"types": "./src/react-auth/index.ts",
			"browser": "./src/react-auth/index.browser.ts"
		},
		"./form": {
			"import": "./src/react-form/index.ts",
			"require": "./src/react-form/index.ts",
			"types": "./src/react-form/index.ts"
		},
		"./head": {
			"import": "./src/react-head/index.ts",
			"require": "./src/react-head/index.ts",
			"types": "./src/react-head/index.ts",
			"browser": "./src/react-head/index.browser.ts"
		},
		"./i18n": {
			"import": "./src/react-i18n/index.ts",
			"require": "./src/react-i18n/index.ts",
			"types": "./src/react-i18n/index.ts"
		},
		"./websocket": {
			"import": "./src/react-websocket/index.ts",
			"require": "./src/react-websocket/index.ts",
			"types": "./src/react-websocket/index.ts"
		}
	}
}
