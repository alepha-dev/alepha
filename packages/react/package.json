{
  "name": "@alepha/react",
  "description": "React components and hooks for building Alepha applications.",
  "author": "Nicolas Foures",
  "version": "0.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "files": [
    "dist",
    "src",
    "assets"
  ],
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "alepha": "0.15.0",
    "jsdom": "^27.4.0",
    "react": "^19.2.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "alepha": "0.15.0",
    "react": "^19"
  },
  "scripts": {
    "lint": "alepha lint",
    "typecheck": "alepha typecheck",
    "test": "vitest run",
    "build": "node scripts/build.ts"
  },
  "homepage": "https://github.com/feunard/alepha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feunard/alepha.git"
  },
  "keywords": [
    "alepha",
    "aleph",
    "framework",
    "react",
    "ssr",
    "form"
  ],
  "exports": {
    "./auth": {
      "types": "./src/auth/index.ts",
      "react-native": "./src/auth/index.browser.ts",
      "browser": "./src/auth/index.browser.ts",
      "import": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    },
    ".": {
      "types": "./src/core/index.ts",
      "import": "./src/core/index.ts",
      "default": "./src/core/index.ts"
    },
    "./form": {
      "types": "./src/form/index.ts",
      "import": "./src/form/index.ts",
      "default": "./src/form/index.ts"
    },
    "./head": {
      "types": "./src/head/index.ts",
      "react-native": "./src/head/index.browser.ts",
      "browser": "./src/head/index.browser.ts",
      "import": "./src/head/index.ts",
      "default": "./src/head/index.ts"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "import": "./src/i18n/index.ts",
      "default": "./src/i18n/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "react-native": "./src/router/index.browser.ts",
      "browser": "./src/router/index.browser.ts",
      "import": "./src/router/index.ts",
      "default": "./src/router/index.ts"
    },
    "./websocket": {
      "types": "./src/websocket/index.ts",
      "import": "./src/websocket/index.ts",
      "default": "./src/websocket/index.ts"
    }
  }
}
