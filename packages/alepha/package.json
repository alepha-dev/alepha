{
	"name": "alepha",
	"version": "0.7.2",
	"type": "module",
	"license": "MIT",
	"description": "TypeScript framework for building full-stack apps with strict conventions, custom schemas, and React-based SPA or SSR without filesystem-based routing.",
	"homepage": "https://github.com/feunard/alepha",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/feunard/alepha.git"
	},
	"main": "./core.js",
	"types": "./core.d.ts",
	"dependencies": {
		"@alepha/cache": "0.7.2",
		"@alepha/core": "0.7.2",
		"@alepha/datetime": "0.7.2",
		"@alepha/lock": "0.7.2",
		"@alepha/postgres": "0.7.2",
		"@alepha/queue": "0.7.2",
		"@alepha/react": "0.7.2",
		"@alepha/react-auth": "0.7.2",
		"@alepha/redis": "0.7.2",
		"@alepha/retry": "0.7.2",
		"@alepha/scheduler": "0.7.2",
		"@alepha/security": "0.7.2",
		"@alepha/server": "0.7.2",
		"@alepha/server-cookies": "0.7.2",
		"@alepha/server-static": "0.7.2",
		"@alepha/server-swagger": "0.7.2",
		"@alepha/testing": "0.7.2",
		"@alepha/topic": "0.7.2",
		"@alepha/vite": "0.7.2"
	},
	"peerDependencies": {
		"@types/react": "^19",
		"react": "^19",
		"vite": "^6"
	},
	"peerDependenciesMeta": {
		"@types/react": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/react": "^19.1.8",
		"pkgroll": "^2.13.1",
		"react": "^19.1.0"
	},
	"scripts": {
		"build": "pkgroll --dist ./"
	},
	"files": [
		"src",
		"assets",
		"**/*.js",
		"**/*.cjs",
		"**/*.d.ts",
		"**/*.map"
	],
	"exports": {
		".": {
			"import": "./core.js",
			"require": "./core.cjs",
			"types": "./core.d.ts"
		},
		"./cache": {
			"import": "./cache.js",
			"require": "./cache.cjs",
			"types": "./cache.d.ts"
		},
		"./core": {
			"import": "./core.js",
			"require": "./core.cjs",
			"types": "./core.d.ts"
		},
		"./datetime": {
			"import": "./datetime.js",
			"require": "./datetime.cjs",
			"types": "./datetime.d.ts"
		},
		"./lock": {
			"import": "./lock.js",
			"require": "./lock.cjs",
			"types": "./lock.d.ts"
		},
		"./postgres": {
			"import": "./postgres.js",
			"require": "./postgres.cjs",
			"types": "./postgres.d.ts"
		},
		"./react": {
			"import": "./react.js",
			"require": "./react.cjs",
			"types": "./react.d.ts"
		},
		"./react/auth": {
			"import": "./react/auth.js",
			"require": "./react/auth.cjs",
			"types": "./react/auth.d.ts"
		},
		"./redis": {
			"import": "./redis.js",
			"require": "./redis.cjs",
			"types": "./redis.d.ts"
		},
		"./retry": {
			"import": "./retry.js",
			"require": "./retry.cjs",
			"types": "./retry.d.ts"
		},
		"./queue": {
			"import": "./queue.js",
			"require": "./queue.cjs",
			"types": "./queue.d.ts"
		},
		"./scheduler": {
			"import": "./scheduler.js",
			"require": "./scheduler.cjs",
			"types": "./scheduler.d.ts"
		},
		"./security": {
			"import": "./security.js",
			"require": "./security.cjs",
			"types": "./security.d.ts"
		},
		"./server": {
			"import": "./server.js",
			"require": "./server.cjs",
			"types": "./server.d.ts"
		},
		"./server/cookies": {
			"import": "./server/cookies.js",
			"require": "./server/cookies.cjs",
			"types": "./server/cookies.d.ts"
		},
		"./server/static": {
			"import": "./server/static.js",
			"require": "./server/static.cjs",
			"types": "./server/static.d.ts"
		},
		"./server/swagger": {
			"import": "./server/swagger.js",
			"require": "./server/swagger.cjs",
			"types": "./server/swagger.d.ts"
		},
		"./topic": {
			"import": "./topic.js",
			"require": "./topic.cjs",
			"types": "./topic.d.ts"
		},
		"./vite": {
			"import": "./vite.js",
			"require": "./vite.cjs",
			"types": "./vite.d.ts"
		}
	},
	"keywords": [
		"alepha",
		"cache",
		"datetime",
		"lock",
		"postgres",
		"queue",
		"react",
		"redis",
		"scheduler",
		"security",
		"server",
		"topic"
	]
}
