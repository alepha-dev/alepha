#!/bin/sh
# Prints what a check or an agent run streams, and what it could reach.
echo '{"type":"system","subtype":"init","model":"claude-stub-1","apiKeySource":"none","claude_code_version":"9.9.9"}'
# No route out: a direct address, which the proxy refuses too.
if wget -q -T 3 -O /dev/null http://1.1.1.1 2>/dev/null; then echo "direct: online"; else echo "direct: offline"; fi
# Through the proxy: a host on the list, and one off it.
if wget -q -T 10 -O /dev/null http://example.com 2>/dev/null; then echo "listed: reached"; else echo "listed: unreachable"; fi
if wget -q -T 5 -O /dev/null http://evil.example 2>/dev/null; then echo "unlisted: reached"; else echo "unlisted: refused"; fi
if [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]; then echo "credential: present"; else echo "credential: absent"; fi
if touch /etc/stub 2>/dev/null; then echo "rootfs: writable"; else echo "rootfs: read-only"; fi
echo "user: $(id -u)"
echo "cwd: $(pwd)"
echo '{"type":"result","subtype":"success","is_error":false,"result":"OK"}'
