{
	"$schema": "https://biomejs.dev/schemas/latest/schema.json",
	"files": {
		"ignoreUnknown": true,
		"experimentalScannerIgnores": ["dist", "node_modules"],
		"includes": [
			"scripts/*.ts",
			"**/apps/**",
			"**/packages/**",
			"!**/node_modules",
			"!**/dist",
			"!**/coverage",
			"!**/assets",
			"!node_modules"
		]
	},
	"formatter": {
		"enabled": true,
		"useEditorconfig": true
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"suspicious": {
				"noExplicitAny": "off",
				"noArrayIndexKey": "off",
				"noConfusingVoidType": "off"
			},
			"correctness": {
				"noUnusedFunctionParameters": "off",
				"noUnusedVariables": "off",
				"noEmptyPattern": "off",
				"useExhaustiveDependencies": "off"
			},
			"performance": {
				"noDelete": "off",
				"noAccumulatingSpread": "off"
			},
			"complexity": {
				"noBannedTypes": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"noParameterAssign": "off"
			},
			"a11y": {
				"recommended": false
			}
		}
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	}
}
